<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="#FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/mainContainer"
        android:padding="16dp"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="50dp">


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/o_voulez_vous_npartir"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_weight="1"
                android:layout_marginEnd="16dp" />


            <ImageButton
                android:id="@+id/btnHistory"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:src="@drawable/ic_history"
                android:contentDescription="@string/historique"
                android:scaleType="centerInside"
                android:padding="10dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/circle_background" />

        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">


            <EditText
                android:id="@+id/etDestination"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="@string/rechercher_une_destination"
                android:drawableStart="@drawable/ic_search"
                android:drawablePadding="8dp"
                android:background="@drawable/input_bg"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="text"
                android:imeOptions="actionSearch" />


            <ImageButton
                android:id="@+id/btnToggleFilters"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_filters"
                android:background="@drawable/btn_filter_cyan"
                android:contentDescription="@string/afficher_les_filtres"
                android:scaleType="centerInside"
                android:padding="12dp"
                android:layout_gravity="center_vertical"
                app:tint="#FFFFFF" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/filterSection"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">


            <Spinner
                android:id="@+id/spinnerType"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_spinner_bg"
                android:popupBackground="#FFFFFF"
                android:paddingStart="12dp"
                android:paddingEnd="36dp"
                android:layout_marginBottom="8dp" />


            <EditText
                android:id="@+id/etPrixMax"
                android:hint="@string/prix_maximal"
                android:inputType="number"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_bg"
                android:paddingStart="12dp"
                android:layout_marginBottom="8dp" />


            <EditText
                android:id="@+id/etDate"
                android:hint="@string/date_de_d_part"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/input_bg"
                android:paddingStart="12dp"
                android:layout_marginBottom="8dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/aucun_voyage_trouv"
            android:textSize="16sp"
            android:gravity="center"
            android:visibility="gone"
            android:padding="16dp"
            android:textColor="#888888"/>


        <TextView
            android:id="@+id/tvCategorieTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cat_gories"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="260dp"
            android:orientation="horizontal"
            android:clipToPadding="false"
            android:overScrollMode="never" />

        <TextView
            android:id="@+id/tvRandomTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quelques_destinations"
            android:textSize="18sp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="12dp"
            android:textStyle="bold"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewRandomVoyages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:clipToPadding="false"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewVoyages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp" />
    </LinearLayout>
</ScrollView>
